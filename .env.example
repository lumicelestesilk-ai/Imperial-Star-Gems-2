# Copy to .env.local and fill in.

# Where the converted frame sequence is served from.
# Leave unset in development: the app falls back to the local /sequence folder.
# In production set this to a real asset CDN origin (Cloudflare R2, Bunny, Vercel
# Blob, S3+CloudFront) — never raw.githubusercontent.com.
# Example: https://cdn.imperialstargems.com/sequence
NEXT_PUBLIC_SEQUENCE_BASE_URL=

# Business contact details (email, phone, WhatsApp) are not configured here —
# they live in src/lib/contact.ts so every deployment shows the same numbers.

# Server-side destination for the in-page enquiry form (src/app/api/enquiry/route.ts).
# Set ONE of these. With neither set the endpoint validates and logs the enquiry
# but does not deliver it — fine for local dev, not for production.
ENQUIRY_WEBHOOK_URL=
ENQUIRY_FORWARD_EMAIL=

# Optional. Absolute path to a MaxMind GeoLite2-Country.mmdb file, used to
# resolve a visitor's country in-process with no network call and no rate limit.
#
# The database is free but its licence requires you to accept the EULA and
# download it under your own key, so it is not committed here. See
# docs/geolocation.md for the steps.
#
# Unset is a supported configuration: detection falls back to CDN country
# headers first and then to the free ipwho.is / ip-api.com services.
# Example: /var/geoip/GeoLite2-Country.mmdb
GEOLITE2_COUNTRY_DB=
