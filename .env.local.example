# Copy to .env.local and fill in. Never commit .env.local.

# MongoDB, provisioned by the Vercel MongoDB integration. The integration names
# this variable after the project, so it is not the usual MONGODB_URI. Pull the
# real value with `vercel env pull .env.local`, or copy it from
# Vercel > Project > Settings > Environment Variables.
imperialstargem_MONGODB_URI=

# Database the inquiries collection lives in. Optional — defaults to
# "imperialstargem" when unset.
MONGODB_DB=
